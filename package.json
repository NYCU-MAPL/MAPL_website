{
  "name": "mapl-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:test": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "eslint .",
    "check": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "test:content": "node --experimental-strip-types --test tests/content-contracts.test.ts",
    "test:shell": "node --experimental-strip-types --test tests/shell-contracts.test.ts",
    "qa:static": "node scripts/run-static-qa.mjs",
    "browser:install": "playwright install chromium",
    "qa:browser": "playwright test",
    "validate:content": "node --experimental-strip-types scripts/validate-content.ts",
    "validate:site": "node --experimental-strip-types scripts/validate-site.ts",
    "verify:assets": "node --experimental-strip-types scripts/validate-content.ts && node scripts/verify-built-assets.mjs && npm run verify:engines",
    "verify:engines": "node scripts/verify-node-engine.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.47.0",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.0",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.10.0",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vue-tsc": "3.3.11"
  }
}
